# Copia in .env e modifica. Non committare .env.
ATLAS_DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:5432/atlas
ATLAS_JWT_SECRET=change-me-with-a-long-random-string
# Provider modelli: "local"/"extractive" funzionano senza Ollama (gratis, offline).
# Con Ollama in esecuzione: ATLAS_EMBED_PROVIDER=ollama, ATLAS_LLM_PROVIDER=ollama
ATLAS_EMBED_PROVIDER=local
ATLAS_LLM_PROVIDER=extractive
ATLAS_OLLAMA_BASE_URL=http://localhost:11434
ATLAS_OLLAMA_EMBED_MODEL=nomic-embed-text
ATLAS_OLLAMA_LLM_MODEL=llama3.2

# Connettori Google reali (OAuth gratuito, setup in docs/CONNECTORS-GOOGLE.md)
# ATLAS_GOOGLE_CLIENT_ID=
# ATLAS_GOOGLE_CLIENT_SECRET=
# ATLAS_GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/connectors/google/callback
# Chiave per cifrare i token dei connettori (obbligatoria per usarli):
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ATLAS_CREDENTIALS_KEY=

# Codici email per register/login (worker Cloudflare separato, vedi codes-worker/).
# La chiave pubblica Ed25519 NON e' un segreto: verifica solo le attestazioni.
# ATLAS_CODES_API_URL=https://atlas.federicotaranu.site
# ATLAS_CODES_PUBLIC_KEY=fuF-owcEmKTrOHw-nlBa4qDxruzoCLw8JGSGctua0FA

# Tuning retrieval ibrido (default ragionevoli, toccare solo per esperimenti):
# ATLAS_RETRIEVAL_CANDIDATES=40
# ATLAS_RETRIEVAL_TOP_K=8
# Pesi del ranking: semantico / testo / recency / confidenza (somma consigliata 1.0)
# ATLAS_W_SEMANTIC=0.55
# ATLAS_W_TEXT=0.25
# ATLAS_W_RECENCY=0.10
# ATLAS_W_CONFIDENCE=0.10

# Agenti: limiti di sicurezza per singolo run
# ATLAS_AGENT_MAX_STEPS=3
# ATLAS_AGENT_TIMEOUT_S=20
# Budget in euro per run agente (0 = nessun costo consentito, default)
# ATLAS_AGENT_BUDGET_EUR=0.0
