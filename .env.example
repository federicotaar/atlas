# Copia in .env e modifica. Non committare .env.
ATLAS_DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:5432/atlas
ATLAS_JWT_SECRET=change-me-with-a-long-random-string
# Provider modelli: "local"/"extractive" funzionano senza Ollama (gratis, offline).
# Con Ollama in esecuzione: ATLAS_EMBED_PROVIDER=ollama, ATLAS_LLM_PROVIDER=ollama
ATLAS_EMBED_PROVIDER=local
ATLAS_LLM_PROVIDER=extractive
ATLAS_OLLAMA_BASE_URL=http://localhost:11434
ATLAS_OLLAMA_EMBED_MODEL=nomic-embed-text
ATLAS_OLLAMA_LLM_MODEL=llama3.2
